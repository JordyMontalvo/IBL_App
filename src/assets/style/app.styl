.menu
  border-top-right-radius: 12px
  border-bottom-right-radius: 12px
  min-width 70%
  transform translate(-100%, 0)
  background #0b375b
  padding: 16px 14px 32px 14px
  display flex
  flex-direction column
  overflow-y auto

  .photo-logo
    height: 70px
    display: block
    margin: 10px auto 20px auto

  .menu-category
    font-size 11px
    font-weight 700
    letter-spacing 0.8px
    color #7e9bb6
    text-transform uppercase
    padding 8px 12px 6px 12px
    margin-top 4px

  .menu-divider
    border-top 1px solid rgba(255, 255, 255, 0.12)
    margin 16px 8px

  .menu-group
    margin-bottom 4px
    border-radius 10px
    transition background-color 0.25s ease

    &.is-open
      background rgba(4, 25, 43, 0.55)
      padding-bottom 4px

      .menu-parent
        color #ffffff
        font-weight 600

  .menu-link
    display flex
    align-items center
    justify-content space-between
    color #e5eef6
    font-size 14.5px
    font-weight 500
    padding 11px 14px
    border-radius 8px
    margin-bottom 4px
    background transparent
    cursor pointer
    text-decoration none
    transition all 0.2s ease
    border 1px solid transparent

    .menu-link-left
      display flex
      align-items center
      gap 12px

    .menu-icon
      width 20px
      font-size 16px
      text-align center
      color #d1e2f0

    .chevron-icon
      font-size 12px
      color #8ba9c4
      transition transform 0.25s ease

    &:hover
      background rgba(255, 255, 255, 0.07)
      color #ffffff
      .menu-icon
        color #ffffff
      .chevron-icon
        color #ffffff

    &.menu-parent
      user-select none

    &.router-link-exact-active
      background #2196f3
      color #ffffff
      font-weight 600
      box-shadow 0 4px 12px rgba(33, 150, 243, 0.35)
      .menu-icon
        color #ffffff

  .sub-menu
    display block
    padding 4px 8px 6px 0
    margin 0 0 6px 20px
    border-left 2px solid rgba(255, 255, 255, 0.2)

    .sub-link
      display flex
      align-items center
      gap 10px
      padding 9px 12px
      margin 4px 0 4px 10px
      font-size 13.5px
      font-weight 500
      color rgba(255, 255, 255, 0.85)
      border-radius 8px
      text-decoration none
      background transparent
      cursor pointer
      transition all 0.2s ease

      .sub-icon
        width 16px
        font-size 14px
        text-align center
        color rgba(255, 255, 255, 0.75)

      &:hover
        background rgba(255, 255, 255, 0.08)
        color #ffffff
        .sub-icon
          color #ffffff

      &.router-link-exact-active,
      &.router-link-active
        background #2196f3
        color #ffffff !important
        font-weight 600
        box-shadow 0 4px 12px rgba(33, 150, 243, 0.4)

        .sub-icon
          color #ffffff !important

  .menu-logout
    margin-top auto
    color #e5eef6
    &:hover
      background rgba(231, 76, 60, 0.15)
      color #ff6b6b
      .menu-icon
        color #ff6b6b

@media (min-width: d-break)
  .menu
    width 260px
    min-width 260px
    max-width 260px
    flex 0 0 260px


