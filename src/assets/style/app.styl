@media (min-width: d-break)
  .app
    >header
      display none
      // padding 16px 40px
      padding 12px 40px
    >section
      .menu
      .content
        //height auto
        min-width auto
        transform none
      .content
        flex 1
        // >header
        //   padding 4px 16px
        >section
