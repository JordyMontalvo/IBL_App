.app
  min-height 100vh
  display flex 
  flex-direction column
  >header
    _flex()
    // background c-blue
    // background c-main-red
    // background c-red
    background linear-gradient(to right, rgba(8, 56, 92, 1), rgba(17, 95, 153, 1), rgba(8, 56, 92, 1))
    color white
    padding 16px
    &.silver
      background linear-gradient(-225deg, #77FFD2 0%, #6297DB 48%, #1EECFF 100%)
    &.gold
      background linear-gradient(to right, #BF953F, #fff380, #B38728, #fff480, #AA771C)
  >section
    display flex
    overflow hidden
    flex 1
    // layout
    .menu
      padding 10px 20px
    .content
      transition all .5s
    .menu
      min-width 70%
      transform translate(-100%, 0)
    .content
      min-width 100%
      transform translate(-70%, 0)
      overflow hidden
      position relative
    &.open
      .menu 
      .content
        transform translate(0, 0)
        height auto
    // style
    .content
      background rgba(109, 193, 255, 0.14)
      >header
        padding 0px 40px
        display flex
        align-items center
        justify-content: space-between;
        color #1b8a45
        border-bottom: 2px solid #1b8a45
        .page-heading__title
          margin 0
          font-weight 700
          font-size 22px
          color #1b8a45
          line-height 1.2
        .page-heading__crumbs
          margin 6px 0 0
          font-size 13px
          font-weight 500
          color #8aa0a6
        .social
          font-size 20px
          margin-left 20px
          a
            padding 8px
      >section
        padding 8px 16px
        padding-bottom 72px

@media (max-width: 450px) 
    .app >section .content >header 
      display none

