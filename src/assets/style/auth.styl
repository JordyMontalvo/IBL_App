.auth
  min-height 100vh
  position relative
  display flex
  flex-direction column
  align-items center
  justify-content center
  padding 2rem


  &:before
    content ''
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    background url('assets/img/bg/iblback.jpg') no-repeat center center / cover
    z-index -2


  &:after
    content ''
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    background-color rgba(0, 77, 155, 0.8) // Color azul con opacidad
    // Alternativa con gradiente:
    // background linear-gradient(rgba(0, 77, 155, 0.8), rgba(0, 48, 97, 0.9))
    z-index -1
  

  .logo-container
    position absolute
    left -300px
    top 50%
    transform translateY(-50%)
    width 250px
    text-align center
    
    img
      width 180px
      height auto
      margin 0 auto 12px auto
      display block

    .hero-banner
      margin-top 12px

      .hero-divider
        width 34px
        height 3px
        background #64b5f6
        margin 12px auto
        border-radius 2px

      .hero-title
        font-size 22px
        font-weight 800
        color #ffffff
        line-height 1.25
        margin 0 0 8px 0

      .hero-desc
        font-size 14.5px
        color rgba(255, 255, 255, 0.9)
        line-height 1.4
        margin 0

  section 
    position relative
    width 100%
    max-width 400px
    text-align center

    h1
      color white
      font-size 28px
      margin-bottom 0.5rem
      font-weight 500
      text-align left
      
      

    .forgot-text
      margin -0.5rem 0 1rem
      color white
      font-size 14px
      text-align left
      
      
      a
        color #FFA500


.register-container
  text-align center

.register-text
  color white
  font-size 14px

  .register-link
    color #FFA500
    text-decoration none
    margin-left 5px
    
    &:hover
      text-decoration underline

.social
  display flex
  justify-content center
  gap 10px
  margin-top 10px     
  


  // >footer
  //   text-align right

.input-mobile 
  display flex 
  align-items center    
  position: relative;
  width: 100%;
  max-width: 600px;


.text-header
  display flex 
  align-items center  
  gap 20px
  padding 12px

@media (min-width: d-break)
  .text-header
    display none


@media (max-width: d-break)
  .auth .logo-container
    position static
    left auto
    top auto
    transform none
    margin: 1rem 0;

@media (max-width: d-break-2)
  .auth .logo-container
    position static
    left auto
    top auto
    transform none
    margin: 1rem 0;

@media (max-width: 768px)
  .input-mobile
    display block

